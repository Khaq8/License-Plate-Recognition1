# Supabase Migration Configuration
# Copy this to .env and fill in your values

# ============================================================================
# SUPABASE CORE CONFIGURATION
# ============================================================================

# Your Supabase project URL (from https://app.supabase.com)
# Format: https://[project-id].supabase.co
SUPABASE_URL="https://your-project-id.supabase.co"

# Anon (public) key - used in client-side code
# Get from: Settings > API > Project API keys > anon public key
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Service Role key - used in backend/server code ONLY
# Get from: Settings > API > Project API keys > service_role key
# NEVER expose this in client code or frontend
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# JWT Secret - used to sign/verify JWT tokens
# Get from: Settings > API > JWT Settings > JWT Secret
# This is the symmetric key for signing tokens
SUPABASE_JWT_SECRET="super-secret-jwt-key-do-not-share"

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Standard PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Host format: db.[project-id].supabase.co
DATABASE_URL="postgresql://postgres:your-database-password@db.your-project-id.supabase.co:5432/postgres"

# Connection string with connection pooling enabled (RECOMMENDED for production)
# Uses pgBouncer on port 6543 for transaction pooling
DATABASE_URL_POOLED="postgresql://postgres:your-database-password@db.your-project-id.supabase.co:6543/postgres"

# For asyncpg/async connections with SQLAlchemy
ASYNC_DATABASE_URL="postgresql+asyncpg://postgres:your-database-password@db.your-project-id.supabase.co:6543/postgres"

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment
ENVIRONMENT="development"  # development, staging, production

# FastAPI settings
DEBUG=True
API_HOST="0.0.0.0"
API_PORT=8000

# CORS settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,https://yourdomain.com"

# ============================================================================
# AUTHENTICATION CONFIGURATION
# ============================================================================

# JWT configuration for your application
JWT_ALGORITHM="HS256"  # HS256 for symmetric, RS256 for asymmetric
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# Custom auth settings (if migrating from custom JWT)
CUSTOM_JWT_SECRET="your-current-jwt-secret"
CUSTOM_JWT_ALGORITHM="HS256"

# OAuth provider settings (optional)
GOOGLE_OAUTH_CLIENT_ID="your-google-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"

GITHUB_OAUTH_CLIENT_ID="your-github-client-id"
GITHUB_OAUTH_CLIENT_SECRET="your-github-client-secret"

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# For Supabase Auth email provider
SMTP_HOST="smtp.resend.com"  # or your email provider
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-email-password"
SMTP_FROM_EMAIL="noreply@yourdomain.com"
SMTP_FROM_NAME="Your App Name"

# Email templates
SUPABASE_EMAIL_REDIRECT_TO="http://localhost:3000/auth/callback"

# ============================================================================
# FILE STORAGE CONFIGURATION (if using Supabase Storage)
# ============================================================================

# Supabase Storage bucket names
STORAGE_BUCKET_NAME="public"  # for public files
STORAGE_AVATAR_BUCKET="avatars"  # for user avatars
STORAGE_DOCUMENTS_BUCKET="documents"  # for documents

# File size limits (in bytes)
MAX_UPLOAD_SIZE=5242880  # 5MB
MAX_AVATAR_SIZE=2097152  # 2MB

# ============================================================================
# REALTIME CONFIGURATION (if using Supabase Realtime)
# ============================================================================

# Enable Realtime subscriptions
ENABLE_REALTIME=true
REALTIME_TIMEOUT=30000  # milliseconds

# ============================================================================
# LOCAL DEVELOPMENT CONFIGURATION
# ============================================================================

# For local Supabase development with `supabase start`
LOCAL_SUPABASE_URL="http://localhost:54321"
LOCAL_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
LOCAL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Supabase CLI configuration
SUPABASE_PROJECT_ID="your-project-id"

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Logging level
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Enable request logging
LOG_REQUESTS=true

# Database query logging (expensive, use only in development)
LOG_DATABASE_QUERIES=false

# Error tracking (Sentry, etc.)
SENTRY_DSN=""

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable features
ENABLE_AUTH_SIGNUP=true
ENABLE_OAUTH=true
ENABLE_SOCIAL_LOGIN=true
REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_MFA=false

# ============================================================================
# RATE LIMITING & SECURITY
# ============================================================================

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Timeout settings
REQUEST_TIMEOUT_SECONDS=30
DATABASE_QUERY_TIMEOUT_SECONDS=10

# HTTPS/SSL
FORCE_HTTPS=false  # true in production
SSL_REDIRECT=false  # true in production

# ============================================================================
# MIGRATION CONFIGURATION
# ============================================================================

# Database migration settings
AUTO_RUN_MIGRATIONS=false  # Set to true to auto-run on startup (careful!)
MIGRATION_PATH="./supabase/migrations"

# Backup settings
BACKUP_ENABLED=true
BACKUP_FREQUENCY="daily"  # daily, weekly, monthly

# ============================================================================
# REDIS/CACHE (optional)
# ============================================================================

REDIS_URL="redis://localhost:6379"
REDIS_CACHE_TTL=3600  # 1 hour

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# Payment processing (if applicable)
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_KEY=""

# ============================================================================
# DOCUMENTATION & HELP
# ============================================================================

# Where to find configuration values:
# - SUPABASE_URL: https://app.supabase.com > Settings > API
# - SUPABASE_ANON_KEY: https://app.supabase.com > Settings > API > Project API keys
# - SUPABASE_SERVICE_ROLE_KEY: https://app.supabase.com > Settings > API > Project API keys
# - SUPABASE_JWT_SECRET: https://app.supabase.com > Settings > API > JWT Settings
# - DATABASE_URL: https://app.supabase.com > Settings > Database > Connection string

# ============================================================================
# SECURITY NOTES
# ============================================================================

# IMPORTANT:
# 1. NEVER commit this file to version control (add to .gitignore)
# 2. NEVER share SUPABASE_SERVICE_ROLE_KEY with anyone
# 3. NEVER expose SERVICE_ROLE_KEY in client/frontend code
# 4. Rotate keys regularly in production
# 5. Use different projects for dev, staging, and production
# 6. Use strong passwords for database access
# 7. Enable MFA for Supabase account
# 8. Regularly audit access logs

# ============================================================================
# LOCAL DEVELOPMENT SETUP
# ============================================================================

# To get started with local Supabase development:
# 1. Install Supabase CLI: npm install -g supabase
# 2. Run: supabase login
# 3. Run: supabase init
# 4. Run: supabase start
# 5. Copy values from output to LOCAL_* variables above
# 6. Create .env file from this template
# 7. Update values with your configuration

# ============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# ============================================================================

# Use these commands to set environment-specific variables:
# Production: source .env.production
# Staging: source .env.staging
# Development: source .env.development

# Example .env.production:
# ENVIRONMENT="production"
# DEBUG=False
# FORCE_HTTPS=true
# REQUIRE_EMAIL_VERIFICATION=true
# SUPABASE_URL="https://prod-project.supabase.co"
# ... etc
